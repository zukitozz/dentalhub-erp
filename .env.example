# PostgreSQL en AWS RDS (Prisma 7 se conecta con el driver adapter `pg`).
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST_RDS:5432/hubdental?schema=public"
# En RDS activa TLS. DATABASE_SSL_STRICT=true valida el certificado (requiere el bundle de CA de RDS).
DATABASE_SSL="true"
DATABASE_SSL_STRICT="false"

NEXTAUTH_SECRET="reemplaza-por-un-secreto-largo-y-aleatorio"
# Opcional: en producción se deduce de la petición. Defínela solo si usas un dominio propio.
# NEXTAUTH_URL="https://tu-dominio.com"
IGV_PORCENTAJE="18"

# Primer usuario (gerente) — npm run seed
ADMIN_EMAIL="gerente@consultorio.pe"
ADMIN_PASSWORD="cambia-esta-contrasena"
ADMIN_NAME="Gerente"

# Google Calendar (opcional) — ver README
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Bucket S3 privado para fotos y radiografías — ver README
AWS_REGION="us-east-2"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Facturación electrónica (facturador SUNAT) — ver README
FACTURADOR_URL=""
FACTURADOR_RUC_EMISOR=""
